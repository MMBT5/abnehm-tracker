# Kopieren nach .env und anpassen (.env bleibt aus dem Repo)
# Host-Ordner mit tracker.db / tracker.xlsx (der Samba-Share)
DATA_DIR=/mnt/storage1/abnehm-tracker
# LAN-/VPN-IP des Servers, auf der die App lauscht
BIND_IP=192.168.1.10
PORT=8099
# Ausgabe von `id -u` / `id -g` des Users, dem DATA_DIR gehört
PUID=1000
PGID=1000
START_DATE=2026-09-28
